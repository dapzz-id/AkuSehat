APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Kunci enkripsi khusus data sensitif / finansial di database (AES-256-GCM + HKDF-SHA256, terpisah dari APP_KEY)
DATA_SECRET_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GEMINI_API_KEY=your_gemini_api_key_here

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================
# MIDTRANS PAYMENT GATEWAY (SNAP)
# ==========================================
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Gxxxxxxxxx

# ==========================================
# GOOGLE PAYMENT & GOOGLE PLAY CONSOLE CONFIG
# ==========================================
# Mode Google Pay Web: 'TEST' (untuk development/sandbox) atau 'PRODUCTION' (live)
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_MERCHANT_ID=BCR2DN4TX7W7XXXX
GOOGLE_PAY_MERCHANT_NAME="AkuSehat Portal"

# Google Play Console In-App Purchase & Subscriptions (Android Mobile)
GOOGLE_PLAY_PACKAGE_NAME=neuracakrawira.asia.akusehat
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Set true jika ingin mewajibkan device integrity (MEETS_DEVICE_INTEGRITY)
# Default false: Hanya memeriksa apakah aplikasi diinstal resmi dari Google Play (appLicensingVerdict: LICENSED), sehingga custom ROM / uncertified tetap bisa pakai
GOOGLE_PLAY_REQUIRE_DEVICE_INTEGRITY=false

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ==========================================
# FIREBASE CLOUD MESSAGING (FCM PUSH NOTIFICATION)
# ==========================================
# FCM v1 HTTP API Project ID dari Firebase Console (cth: akusehat-mobile-xxxx)
FCM_PROJECT_ID=
# Path file service-account.json untuk FCM v1 HTTP API (relatif dari storage/app atau absolute path)
FCM_SERVICE_ACCOUNT_JSON=
# Server Key FCM Legacy (opsional sebagai fallback jika tidak memakai service account)
FCM_SERVER_KEY=

GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Cloudflare Turnstile (Anti-Bot Web Protection)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Machine-to-Machine (S2S) Cryptographic Request Signing (HMAC-SHA256 + Anti-Replay)
S2S_STRICT_MODE=false
S2S_SHARED_SECRET=akusehat-s2s-hmac-v1-9c4f8a2e7b1d6c3a5e0f9b8d7c6a5e4f3b2a1d0c
S2S_TOLERANCE_SECONDS=60
